---
layout: base.njk
---
<article class="news-post">

  {% if cover_image %}
    <div class="post-cover">
      <img src="{{ cover_image }}" alt="{{ title_fr or title_en or title }}" />
    </div>
  {% endif %}

  <header class="post-header">
    <div data-lang="fr" class="language-content">
      <h2 class="post-title">{{ title_fr or title }}</h2>
    </div>
    <div data-lang="en" class="language-content">
      <h2 class="post-title">{{ title_en or title }}</h2>
    </div>
    <div class="post-meta">
      <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      {% if author %}<span class="post-author"> — {{ author }}</span>{% endif %}
    </div>
  </header>
  <div data-lang="fr" class="language-content post-body">
    {{ body_fr | markdownify | safe }}
  </div>
  <div data-lang="en" class="language-content post-body">
    {{ body_en | markdownify | safe }}
  </div>

  {% set prevPost = collections.events | prevEvent(page.url) %}
  {% set nextPost = collections.events | nextEvent(page.url) %}

  <footer class="post-footer">
    <a href="/events/" data-nav-link class="back-link">All Happenings</a>
    <div class="event-nav-buttons">
      {% if prevPost %}
        <a href="{{ prevPost.url }}" data-nav-link class="back-link"><span class="back-arrow">←</span>Previous</a>
      {% endif %}
      {% if nextPost %}
        <a href="{{ nextPost.url }}" data-nav-link class="back-link">Next<span class="back-arrow">→</span></a>
      {% endif %}
    </div>
  </footer>

</article>
