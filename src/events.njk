---
layout: base.njk
title: Événements — PLAYGROUND
---
<div class="news-listing">

  <div id="content-fr" class="language-content">
    <h2 class="page-heading">Événements</h2>
  </div>
  <div id="content-en" class="language-content">
    <h2 class="page-heading">Events</h2>
  </div>

  {% if collections.events.length %}
    <ul class="events-grid">
      {% for post in collections.events %}
        <li class="events-grid-item">
          <a href="{{ post.url }}" data-nav-link class="events-grid-card">
            {% if post.data.cover_image %}
              <img src="{{ post.data.cover_image }}" alt="" class="events-grid-image" />
            {% endif %}
            <div class="events-grid-overlay">
              <span data-lang="fr" class="language-content events-grid-title">{{ post.data.title_fr or post.data.title }}</span>
              <span data-lang="en" class="language-content events-grid-title">{{ post.data.title_en or post.data.title }}</span>
              <time class="events-grid-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
              {% if post.data.author %}
                <span class="events-grid-author">{{ post.data.author }}</span>
              {% endif %}
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div id="content-fr" class="language-content"><p><em>Aucun événement pour le moment.</em></p></div>
    <div id="content-en" class="language-content"><p><em>No events yet.</em></p></div>
  {% endif %}

</div>
